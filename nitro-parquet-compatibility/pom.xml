<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.weakref</groupId>
        <artifactId>nitro-parent</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>nitro-parquet-compatibility</artifactId>
    <name>nitro-parquet-compatibility</name>
    <description>Explicit Nitro engine and Parquet compatibility adapters</description>

    <dependencies>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.hardwood</groupId>
            <artifactId>hardwood-core</artifactId>
            <version>1.0.0.Alpha1</version>
        </dependency>

        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>slice</artifactId>
        </dependency>

        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>units</artifactId>
            <version>1.12</version>
        </dependency>

        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>trino-memory-context</artifactId>
            <version>479</version>
        </dependency>

        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>trino-parquet</artifactId>
            <version>479</version>
        </dependency>

        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>trino-spi</artifactId>
            <version>479</version>
        </dependency>

        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
            <version>2.14.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-hadoop</artifactId>
            <version>1.16.0</version>
        </dependency>

        <dependency>
            <groupId>org.weakref</groupId>
            <artifactId>nitro-engine</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.weakref</groupId>
            <artifactId>nitro-parquet</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.weakref</groupId>
            <artifactId>nitro-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.self="merge">
                        <arg>-sourcepath</arg>
                        <arg>${project.basedir}/src/main/java</arg>
                    </compilerArgs>
                    <includes>
                        <include>io/trino/parquet/**/*.java</include>
                        <include>org/weakref/nitro/operator/source/compatibility/parquet/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-source-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>io/trino/parquet/**/*.java</include>
                        <include>org/weakref/nitro/operator/source/compatibility/parquet/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
        <sourceDirectory>../src/main/java</sourceDirectory>
    </build>
</project>
